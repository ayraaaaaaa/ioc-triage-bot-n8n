    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $input.item.json.message || {};\nconst raw = (msg.text || '').trim();\nconst chatId = msg.chat ? msg.chat.id : null;\n\n// refang common defanged IOCs: hxxp, [.]\nconst text = raw.replace(/\\[\\.\\]/g, '.').replace(/hxxp/gi, 'http');\n\nconst ipRe = /^(\\d{1,3}\\.){3}\\d{1,3}$/;\nconst hashRe = /^([a-fA-F0-9]{32}|[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$/;\nconst urlRe = /^https?:\\/\\/\\S+$/i;\nconst domainRe = /^(?!-)([a-z0-9-]{1,63}\\.)+[a-z]{2,}$/i;\nconst greetRe = /^(\\/start|\\/help|hi|hello|hey)\\b/i;\n\nlet iocType = 'unknown';\nif (greetRe.test(text)) iocType = 'greeting';\nelse if (ipRe.test(text)) iocType = 'ip';\nelse if (hashRe.test(text)) iocType = 'hash';\nelse if (urlRe.test(text)) iocType = 'url';\nelse if (domainRe.test(text)) iocType = 'domain';\n\nreturn { json: { iocType, ioc: text, chatId, firstName: msg.from ? msg.from.first_name : '' } };"
      },
