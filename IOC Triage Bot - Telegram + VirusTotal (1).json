      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $('Format VT Verdict').item.json;\nconst ai = (($json.choices && $json.choices[0] && $json.choices[0].message.content) || '').trim();\nconst summary = ai || 'AI summary unavailable.';\n\nconst detLine = f.detections === 'n/a' ? 'Detections: n/a'\n  : `Detections: ${f.detections} engines flagged this`;\n\nconst reply = `IOC: ${f.ioc} (${f.iocType})\\nVerdict: ${f.verdict}\\n${detLine}\\n\\n${summary}`;\nreturn { json: { chatId: f.chatId, reply } };"
