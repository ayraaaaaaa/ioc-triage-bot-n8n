    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const det = $('IOC Type Detector').item.json;\nconst attrs = ($json.data && $json.data.attributes) || null;\nconst base = { chatId: det.chatId, ioc: det.ioc, iocType: det.iocType };\n\nif (!attrs) {\n  return { json: { ...base, verdict: 'Not found', flagged: 0, total: 0, detections: 'n/a',\n    aiPrompt: `IOC: ${det.ioc}\\nType: ${det.iocType}\\nVerdict: Not found\\nVirusTotal has no record of this IOC.` } };\n}\n\nconst s = attrs.last_analysis_stats || {};\nconst m = s.malicious || 0, sus = s.suspicious || 0, h = s.harmless || 0, u = s.undetected || 0;\nconst total = m + sus + h + u;\nconst flagged = m + sus;\n\nlet verdict = 'Clean';\nif (m >= 5) verdict = 'Malicious';\nelse if (flagged > 0) verdict = 'Suspicious';\n\nconst aiPrompt = `IOC: ${det.ioc}\\nType: ${det.iocType}\\nVerdict: ${verdict}\\nEngines flagging it: ${flagged} of ${total}`;\nreturn { json: { ...base, verdict, flagged, total, detections: `${flagged}/${total}`, aiPrompt } };"
      },
