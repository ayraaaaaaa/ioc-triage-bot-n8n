        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a SOC assistant. Reply with one or two plain-English sentences, no markdown, no bullet points, explaining the VirusTotal verdict to a non-expert. Style example: The domain example.com is considered safe, with no security engines flagging it as malicious. For Suspicious or Malicious results, add one short recommended action.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.aiPrompt) }}\n    }\n  ]\n}",
